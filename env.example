# BNHBot 环境变量配置
# 复制此文件为 .env 并根据你的环境进行配置

# 数据库配置
# 支持 SQLite、MySQL、PostgreSQL
DATABASE_URL=sqlite:data/bnhbot.db

# 钉钉机器人配置
# 在钉钉群中添加自定义机器人后获取
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_ACCESS_TOKEN
# 机器人安全设置中的签名密钥（如果设置了签名验证）
DINGTALK_SECRET=YOUR_SECRET_KEY
# 启动时是否@所有人 (true/false)
DINGTALK_AT_ALL=false

# Web服务器配置
# 服务器监听地址 (127.0.0.1=仅本地访问, 0.0.0.0=允许所有IP访问)
WEB_SERVER_HOST=127.0.0.1
# 服务器端口号
WEB_SERVER_PORT=3000
# 完整的基础URL，用于生成链接 (开发环境: http://localhost:3000, 生产环境: https://yourdomain.com)
WEB_SERVER_BASE_URL=http://localhost:3000

# 日志级别 (debug, info, warn, error)
RUST_LOG=info

# 管理员安全配置
# 管理员登录密码（请设置强密码）
ADMIN_PASSWORD=your_secure_admin_password_here
# JWT密钥（用于生成访问令牌，请设置随机字符串）
JWT_SECRET=your_jwt_secret_key_here_should_be_very_long_and_random
# 会话超时时间（小时）
SESSION_TIMEOUT_HOURS=24
